
button::after {
	border: none;
}
.but {
	height: 80rpx;
	width: 100%;
	margin: auto;
	border-radius: 50px;
	line-height: 80rpx;
	color: #fff;
	background-color: #1C7231;
}
.btn_van {
	position: absolute;
	bottom: 10px;
	left: 50%;
	-webkit-transform: translate(-50%, -50%);
	        transform: translate(-50%, -50%);
	width: 95%;
}
.cell_van {
	margin-bottom: 15px;
	width: 100%;
	background-color: #fff;
	margin: 0 auto 0 auto;
	border-radius: 15rpx !important;
}
.uni-list-item {
	border-radius: 15rpx !important;
}
.is-input-border {
	border-bottom-left-radius: 15rpx !important;
	border-bottom-right-radius: 15rpx !important;
	border: none !important;
}

