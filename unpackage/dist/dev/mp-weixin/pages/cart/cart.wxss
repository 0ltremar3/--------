::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
  color: transparent;
}
page {
  background: #F7F8F5;
}
.cart-page {
  min-height: 100vh;
  padding-bottom: 184rpx;
  background: #F7F8F5;
}
/* ── 顶部导航 ── */
.cart-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E6E2;
}
.cart-nav__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #202321;
  letter-spacing: 2rpx;
}
.cart-nav__action {
  font-size: 28rpx;
  color: #8E918D;
}
.cart-nav__action--active {
  color: #1C7231;
}
/* ── 空状态 ── */
.cart-empty__btn {
  margin-top: 32rpx;
  padding: 20rpx 64rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #1C7231;
  text-align: center;
}
/* ── 列表区域 ── */
.cart-list {
  margin-top: 96rpx;
}
/* ── 商品行 ── */
.cart-item {
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E6E2;
}
.cart-item--expired {
  background: #FFFFFF;
}
.cart-item__inner {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 32rpx;
  gap: 20rpx;
}
.cart-item__check-wrap {
  display: flex;
  align-items: center;
  padding-top: 64rpx;
}
.cart-item__img-wrap {
  position: relative;
  flex-shrink: 0;
}
.cart-item__img {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: #ECEDE8;
}
.cart-item__expired-badge {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(32, 35, 33, 0.55);
  padding: 4rpx 20rpx;
  white-space: nowrap;
}
.cart-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.cart-item__body--h5 {
  flex: 1;
}
.cart-item__name {
  font-size: 28rpx;
  font-weight: 500;
  color: #202321;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.cart-item__name--expired {
  color: #B8BBB6;
}
.cart-item__attr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8E918D;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-item__suk {
  margin-right: 16rpx;
}
.cart-item__services-scroll {
  margin-top: 12rpx;
}
.cart-item__services {
  display: flex;
  flex-direction: row;
}
.cart-item__service-tag {
  border: 1rpx solid #E5E6E2;
  height: 36rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 0 12rpx;
  line-height: 34rpx;
  font-size: 20rpx;
  color: #8E918D;
  white-space: nowrap;
}
.cart-item__seckill-tip {
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #1C7231;
  align-self: flex-start;
}
.cart-item__seckill-tip text {
  font-size: 20rpx;
  color: #1C7231;
}
.cart-item__bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
/* ── 复选框 ── */
.cart-checkbox {
  font-size: 48rpx;
  line-height: 1;
  color: #C8CBC4;
  margin-right: 16rpx;
}
.cart-checkbox.checked {
  color: #1C7231;
}
/* ── 底部结算栏 ── */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 99;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E6E2;
  box-shadow: 0 -6rpx 20rpx rgba(32, 35, 33, 0.025);
}
.cart-footer__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 136rpx;
  padding: 0 36rpx;
}
.cart-footer__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}
.cart-footer__all-check {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.cart-footer__all-label {
  font-size: 30rpx;
  color: #202321;
}
.cart-footer__total {
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
}
.cart-footer__total-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}
.cart-footer__total-label {
  font-size: 26rpx;
  color: #8E918D;
}
.cart-footer__discount {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B8BBB6;
}
.cart-footer__btn {
  min-width: 192rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 44rpx;
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #1C7231;
  border-radius: 0;
  box-shadow: none;
  transition: background 0.2s, color 0.2s;
}
.cart-footer__btn--ghost {
  background: #FFFFFF;
  color: #1C7231;
  border: 1rpx solid #1C7231;
}
.cart-footer__btn--disabled {
  background: #C8CBC4;
  color: #FFFFFF;
}
