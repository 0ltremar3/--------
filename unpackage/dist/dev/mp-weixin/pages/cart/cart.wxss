::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
  color: transparent;
}
page {
  background-color: #f5f5f5;
}
.container {
  padding-bottom: 134rpx;
}
.list {
  margin-top: 120rpx;
}
.edit-van {
  position: fixed;
  display: flex;
  top: 0;
  height: 80rpx;
  width: 100%;
  line-height: 80rpx;
  background: #fff;
  padding: 0 33rpx;
  font-size: 27rpx;
  z-index: 9999;
}
.qgg {
  text-align: center;
  margin-top: 20rpx;
  font-size: 27rpx;
  color: #f32020;
}
.efficay_text {
  position: absolute;
  left: 65rpx;
  top: 143rpx;
  z-index: 8;
  font-size: 34rpx;
  color: #fff;
  background-color: rgba(62, 62, 62, 0.5);
  padding: 4rpx 26rpx;
  border-radius: 41rpx;
}
/* 购物车列表项 */
.list-item {
  display: flex;
  position: relative;
  padding: 20rpx 15rpx;
  background-color: #fff;
  border-radius: 20rpx;
  margin: 30rpx 20rpx;
}
.checkbox {
  z-index: 8;
  font-size: 60rpx;
  line-height: 1;
  padding: 4rpx;
  color: #c7c7c7;
  background: #fff;
  border-radius: 50px;
}
.litpic {
  width: 200rpx;
  height: 200rpx;
  border-radius: 15rpx;
  margin-left: 20rpx;
}
.title {
  font-size: 29rpx;
  color: #000;
  height: 40rpx;
  line-height: 40rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.price {
  font-size: 29rpx;
  height: 50rpx;
  line-height: 50rpx;
}
.price:before {
  content: "￥";
  font-size: 24rpx;
  margin: 0 2rpx 0 -4rpx;
}
.attr {
  font-size: 24rpx;
  color: #909399;
  height: 42rpx;
  line-height: 37rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.attr .suk_text {
  margin-right: 20rpx;
}
.Delete {
  padding: 4rpx 10rpx;
  font-size: 29rpx;
  height: 50rpx;
  color: #909399;
  background: #fff;
  display: flex;
  justify-content: flex-end;
}
.services_van {
  display: flex;
  flex-direction: row;
  text-align: center;
}
.services_van .services_vans {
  border: 1rpx solid #ff3b3b;
  height: 35rpx;
  margin-bottom: 10rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  line-height: 34rpx;
}
.services_van .services_vans .goods_services {
  color: #ff3b3b;
  font-size: 19rpx;
  padding: 0 8rpx;
}
.attr_van {
  border: 1rpx solid #1C7231;
  height: 40rpx;
  width: 64%;
  border-radius: 8rpx;
  line-height: 27rpx;
  margin-bottom: 13rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.attr_van .suk_prompt {
  color: #1C7231;
  font-size: 21rpx;
}
/* 底部栏 */
.footer .checkbox.checked,
.list-item .checkbox.checked {
  color: #1C7231;
}
.footer {
  position: fixed;
  z-index: 95;
  display: flex;
  align-items: center;
  width: 100rpx;
  height: 100rpx;
  padding: 0 30rpx;
  background: #fff;
  bottom: 0px;
  width: 100%;
  border-top: 1rpx solid #f5f5f5;
}
.checkbox {
  height: 48rpx;
  position: relative;
}
.checkbox image {
  width: 44rpx;
  height: 100%;
  position: relative;
  z-index: 5;
}
.price {
  font-size: 29rpx;
  color: #1C7231;
}
.coupon {
  font-size: 24rpx;
  color: #bdbdbd;
}
.coupon text {
  color: #bdbdbd;
}
.confirm-btn {
  padding: 0 38rpx;
  margin: 0;
  border-radius: 100px;
  height: 65rpx;
  line-height: 65rpx;
  font-size: 27rpx;
  color: #fff;
  background: #1C7231;
  box-shadow: 1px 2px 5px rgba(217, 137, 138, 0.7);
}
