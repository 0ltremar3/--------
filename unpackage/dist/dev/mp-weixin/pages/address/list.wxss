
page {
	background: #f3f3f3;
	height: 100%;
}
.container {
	position: relative;
	padding: 30rpx;
	padding-bottom: 200rpx;
}
.ress_van {
	width: 100%;
	height: 250rpx;
	background-color: #fff;
	border-radius: 25rpx;
	margin-bottom: 30rpx;
}
.ress_top {
	width: 100%;
	height: 175rpx;
	display: flex;
	flex-direction: row;
	border-bottom: 1rpx solid #d8d8d8;
}
.ress_dwt {
	width: 58rpx;
	height: 58rpx;
	margin: auto 20rpx;
	border-radius: 50%;
}
.ress_text_van {
	margin: auto 0rpx;
	width: 72%;
}
.fs_34 {
	font-size: 34rpx
}
.ress_mo {
	font-size: 30rpx;
	margin-left: 10rpx;
	color: #4c4c4c;
}
.ress_ed {
	margin-top: 6rpx;
	font-size: 30rpx;
	color: #4c4c4c;
	word-break: break-all;
	overflow: hidden;
	text-overflow: ellipsis;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
}
.ress_bjt {
	width: 50rpx;
	height: 50rpx;
	margin: auto 20rpx;
}
.ress_bot {
	display: flex;
	flex-direction: row;
}
.ress_mrt {
	margin: auto 10rpx auto 20rpx;
	font-size: 58rpx;
	color: #d8d8d8;
}
.ress_mrtext {
	display: flex;
	flex: 1;
	margin: auto 0rpx;
	font-size: 30rpx;
	color: #4c4c4c;
}
.ress_scbut {
	background-color: rgba(255, 255, 255, 0);
	font-size: 30rpx;
	color: #4c4c4c;
}
button::after {
	border: none;
}
.but {
	width: 94%;
	position: fixed;
	bottom: 16rpx;
	left: 50%;
	-webkit-transform: translateX(-50%);
	        transform: translateX(-50%);
	font-size: 32rpx;
	color: #ffffff;
	background-color: #1C7231;
	border-radius: 100rpx;
	height: 84rpx;
	line-height: 84rpx;
	z-index: 9999;
}
.checked {
	color: #1C7231;
}

