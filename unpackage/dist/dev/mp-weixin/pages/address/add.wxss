
.container {
	background-color: #ffffff;
	padding: 40rpx;
	box-sizing: border-box;
}
.wxress_van {
	display: flex;
	flex-direction: row;
}
.wxress_img {
	width: 40rpx;
	height: 40rpx;
}
.wxress_text {
	margin-left: 10rpx;
	height: 40rpx;
	line-height: 40rpx;
	font-size: 30rpx;
	color: #303133;
}
.but {
	width: 94%;
	position: absolute;
	bottom: 16rpx;
	left: 50%;
	-webkit-transform: translateX(-50%);
	        transform: translateX(-50%);
	font-size: 32rpx;
	color: #ffffff;
	background-color: #1C7231;
	border-radius: 100rpx;
	height: 84rpx;
	line-height: 84rpx;
	z-index: 9999;
}

