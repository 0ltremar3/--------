::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
  color: transparent;
}
.list {
  padding: 30rpx 30rpx;
}
.mt-20 {
  margin-top: 20rpx;
}
.flex-dir-row {
  display: flex;
  flex-direction: row;
}
.flex-dir-column {
  display: flex;
  flex-direction: column;
}
.flex-x-between {
  justify-content: space-between;
}
.litpic {
  width: 210rpx;
  height: 210rpx;
  border-radius: 20rpx;
}
.list-right {
  width: 68%;
}
.title {
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.attr {
  font-size: 26rpx;
  color: #909399;
  height: 50rpx;
  line-height: 50rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.attr .suk_text {
  margin-right: 20rpx;
}
.list-right {
  margin-left: 20rpx;
}
.price {
  font-size: 34rpx;
  color: #1C7231;
  height: 40rpx;
  line-height: 40rpx;
}
.services_van {
  display: flex;
  flex-direction: row;
  text-align: center;
  overflow: hidden;
}
.services_van .services_vans {
  border: 1rpx solid #ff5500;
  height: 40rpx;
  margin-bottom: 10rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  line-height: 36rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  flex-shrink: 0;
}
.services_van .services_vans .goods_services {
  color: #ff5500;
  font-size: 21rpx;
  padding: 0 10rpx;
}
