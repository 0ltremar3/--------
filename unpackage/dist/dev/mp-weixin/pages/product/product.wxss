}
.coupon-qian {
  font-size: 52rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.coupon-lqsy {
  font-size: 24rpx;
  height: 36rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  color: #1C7231;
  line-height: 36rpx;
  margin: 12rpx auto auto auto;
  width: 120rpx;
  text-align: center;
}
button::after {
  border: none;
}
/* 微信小程序自定义顶部返回 */
.navbar {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 10;
}
.navbar .navbar-title {
  background: rgba(255, 255, 255, 0.82);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  position: fixed;
  left: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  overflow: hidden;
}
.navbar .navbar-return {
  width: 70rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  position: fixed;
  left: 0;
}
.navbar .icon-arrow-left {
  font-size: 36rpx;
  color: #202321;
}
.minprice:before {
  content: "￥";
  font-size: 24rpx;
  margin: 0 2rpx 0 -4rpx;
}
/* 覆盖 jlg-minPrice 组件内 ¥ 前缀字号，与 maxSize 比例协调 */
.list-item .minprices::before {
  font-size: 28rpx;
}
.product-price-pair {
  align-items: flex-end;
  line-height: 1;
}
.product-price-pair .price-original {
  margin-bottom: 6rpx;
}
/* 划线原价 */
.price-original {
  font-family: "Abel", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  font-size: 26rpx;
  font-weight: 400;
  color: #8E918D;
  text-decoration: line-through;
  line-height: 32rpx;
}
.price-original::before {
  content: "¥";
  font-family: inherit;
  font-size: 24rpx;
  margin-right: 1rpx;
}
