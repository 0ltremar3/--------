/* 品牌价格字体栈 —— 数字优先使用 Abel，降级至系统无衬线 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
  color: transparent;
}
page {
  background: #FFFFFF;
  padding-bottom: 160rpx;
}
.b-b {
  border-bottom: 1rpx solid #E5E6E2;
}
.icon-uniE003 {
  font-size: 26rpx;
  color: #8E918D;
}
.name {
  margin-bottom: 11rpx;
}
.swiper-list {
  height: 750rpx;
}
.swiper {
  height: 750rpx;
  position: relative;
}
/* 秒杀信息条 */
.search-backurl {
  position: relative;
  padding: 20rpx 32rpx;
  background: #202321;
}
.backimg {
  width: 100%;
  height: 125rpx;
  height: 120rpx;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
}
/* 轮播图数字指示器 */
.current {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background-color: rgba(32, 35, 33, 0.45);
  color: #FFFFFF;
  text-align: center;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}
.swiperImg {
  width: 100%;
  height: 100%;
}
/* 信息卡片 */
.list-item {
  width: 100%;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}
/* 商品名称 */
.product-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #202321;
  line-height: 1.45;
  flex: 1;
}
/* 分享按钮 */
.share-btn {
  background: transparent !important;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-left: 16rpx;
  flex-shrink: 0;
  border: none !important;
}
/* 限时秒杀标签 */
.deal-tip {
  font-size: 24rpx;
  color: #1C7231;
  border: 1rpx solid #1C7231;
  line-height: 1;
  padding: 5rpx 12rpx;
  margin-left: 16rpx;
}
/* 秒杀区白色小标签 */
.seckill-tag {
  font-size: 24rpx;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  line-height: 1;
  padding: 5rpx 12rpx;
}
/* 折扣标签 */
.deal-tips {
  font-size: 24rpx;
  color: #8E918D;
  border: 1rpx solid #B8BBB6;
  line-height: 1;
  padding: 5rpx 12rpx;
}
.list-title-left {
  width: 110rpx;
  text-align: left;
  color: #8E918D;
  font-size: 26rpx;
}
/* 加入购物车按钮（次按钮） */
.footer-left {
  width: 210rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #F7F8F5 !important;
  color: #2B2F2C;
  border-radius: 0;
  height: 88rpx;
  line-height: 88rpx;
}
/* 立即购买按钮（主按钮） */
.footer-right {
  width: 210rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #1C7231 !important;
  color: #FFFFFF;
  border-radius: 0;
  height: 88rpx;
  line-height: 88rpx;
}
/* 秒杀立即购买按钮 */
.footer-rights {
  width: 360rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #1C7231 !important;
  color: #FFFFFF;
  border-radius: 0;
  height: 88rpx;
  line-height: 88rpx;
}
/* 优惠券标签 */
.coupon-btn {
  background-color: transparent;
  border: 1rpx solid #1C7231;
  margin-right: 10rpx;
  font-size: 24rpx;
  padding: 5rpx 12rpx;
  color: #1C7231;
  line-height: 1;
}
/* 评价区域 */
.eva-section {
  display: flex;
  flex-direction: column;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  margin-top: 2rpx;
}
.eva-section .e-header {
  display: flex;
  align-items: center;
  height: 60rpx;
  font-size: 24rpx;
  color: #8E918D;
}
.eva-section .e-header .tit {
  font-size: 28rpx;
  font-weight: 500;
  color: #202321;
  margin-right: 6rpx;
}
.eva-section .e-header .tip {
  flex: 1;
  text-align: right;
  color: #8E918D;
}
.eva-section .e-header .icon-uniE003 {
  margin-left: 8rpx;
}
.eva-box {
  display: flex;
  padding: 20rpx 0;
}
.eva-box .portrait {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.eva-box .right {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-left: 24rpx;
  font-size: 26rpx;
  color: #2B2F2C;
}
.eva-box .right .con {
  font-size: 26rpx;
  padding: 14rpx 0;
  color: #2B2F2C;
  line-height: 1.6;
}
.eva-box .right .bot {
  display: flex;
  justify-content: space-between;
  color: #8E918D;
  font-size: 24rpx;
}
/* 图文详情 */
.detail-desc {
  background: #FFFFFF;
  margin-top: 2rpx;
  padding-bottom: 100rpx;
}
.detail-desc .d-header {
  display: flex;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  align-items: center;
  justify-content: center;
  color: #8E918D;
  position: relative;
  height: 88rpx;
}
.detail-desc .d-header text {
  background: #FFFFFF;
  padding: 0 24rpx;
  position: relative;
  z-index: 1;
}
.detail-desc .d-header:after {
  position: absolute;
  left: 50%;
  top: 50%;
  -webkit-transform: translateX(-50%);
          transform: translateX(-50%);
  width: 300rpx;
  height: 0;
  content: "";
  border-bottom: 1rpx solid #E5E6E2;
}
/* 规格选择弹窗 */
.spec-content {
  padding: 32rpx;
}
.spec-content .spec-top {
  display: flex;
}
.spec-content .spec-top image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 4rpx;
  background-color: #ECEDE8;
  flex-shrink: 0;
}
.spec-content .spec-top .right {
  display: flex;
  flex-direction: column;
  padding-left: 24rpx;
  font-size: 28rpx;
  color: #202321;
  line-height: 44rpx;
}
.spec-content .spec-list {
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  font-weight: 500;
  color: #202321;
  padding-top: 32rpx;
  padding-left: 0;
}
.spec-content .item-list {
  padding: 20rpx 0 0;
  display: flex;
  flex-wrap: wrap;
}
.spec-content .item-list text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7F8F5;
  border: none;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 32rpx;
  min-width: 60rpx;
  height: 60rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  color: #2B2F2C;
}
.spec-content .item-list .selected {
  background: rgba(28, 114, 49, 0.08);
  color: #1C7231;
  border: 1rpx solid #1C7231;
}
/* 底部操作栏 */
.footer {
  position: fixed;
  left: 0;
  bottom: 0;
  z-index: 95;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding-top: 16rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E6E2;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
/* 底部快捷入口图标 */
.footer-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8E918D;
  width: 80rpx;
  height: 80rpx;
}
.footer-btn .iconfont {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #8E918D;
}
.footer-btn.active, .footer-btn.active .iconfont {
  color: #1C7231;
}
/* 规格弹窗确认按钮 */
.makesure {
  width: 100%;
  background-color: #1C7231;
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
  margin-top: 40rpx;
  padding: 28rpx 0;
  box-sizing: border-box;
}
/* 优惠券弹窗 */
.coupon-diej {
  position: absolute;
  right: 0;
  top: 0;
  background: #8E918D;
  color: #FFFFFF;
  z-index: 99;
  font-size: 24rpx;
  padding: 5rpx 10rpx;
  border-top-right-radius: 8rpx;
  border-bottom-left-radius: 8rpx;
}
.coupon-z {
  font-size: 36rpx;
  font-weight: 600;
}
.coupon-cen {
  height: 60vh;
  padding: 20rpx;
}
.coupon-van {
  width: 100%;
  height: 200rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  border: 1rpx solid #E5E6E2;
  position: relative;
  margin-top: 16rpx;
}
.coupon-letf {
  position: absolute;
  left: 0;
  top: 0;
  width: 67%;
}
.coupon-icqc {
  height: 36rpx;
  background: #1C7231;
  border-radius: 4rpx;
  color: #FFFFFF;
  padding: 0 12rpx;
  line-height: 36rpx;
  font-size: 24rpx;
  margin-top: 30rpx;
  margin-left: 20rpx;
  margin-right: 10rpx;
}
.coupon-name {
  font-size: 30rpx;
  line-height: 85rpx;
  color: #202321;
  font-weight: 500;
}
.coupon-righ {
  width: 33%;
  height: 100%;
  background: #1C7231;
  position: absolute;
  right: 0;
  border-bottom-right-radius: 8rpx;
  border-top-right-radius: 8rpx;
  color: #FFFFFF;
