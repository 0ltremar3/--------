
page {
	background-color: #fff;
	color: #fff;
}
.col-blue {
	color: blue;
}
.container {
	padding: 20rpx 5rpx;
	box-sizing: border-box;
	background-color: #f5f5f5;
	min-height: 100vh;
}
.h-100 {
	height: 100vh;
}
.list-item {
	background-color: #fff;
	box-shadow: 0px 1px 14px 1px #f5f5f5;
	display: flex;
	flex-direction: column;
	margin: 10rpx 20rpx 30rpx 20rpx;
	color: #000;
	border-radius: 20rpx;
	font-size: 30rpx;
	padding-bottom: 35rpx;
	box-sizing: border-box;
}
.list-top {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	background: #ffdfdf87;
	padding: 30rpx;
	border-radius: 20rpx 20rpx 0 0;
}
.list-bottom {
	padding-top: 15rpx;
	margin: 0 30rpx;
	margin-top: 15rpx !important;
}
.b-f {
	background-color: #fff;
}
.col-2b8779 {
	color: #2b8779;
}
.col-ff1115 {
	color: #ff1115;
}
.col-959595 {
	color: #959595;
}
.litpic {
	width: 50rpx;
	height: 50rpx;
	border-radius: 50%;
}

