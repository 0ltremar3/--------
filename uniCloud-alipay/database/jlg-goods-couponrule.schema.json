{
    "bsonType": "object",
    "description": "优惠卷规则",
    "required": [],
    "permission": {
        "read": true,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID，系统自动生成"
        },
        "type": {
            "bsonType": "string",
            "description": "类型，满减或折扣",
            "label": "优惠类型",
            "trim": "both"
        },
        "name": {
            "bsonType": "string",
            "description": "优惠卷名称",
            "label": "名称",
            "trim": "both"
        },
        "price": {
            "bsonType": "int",
            "description": "满减金额、折扣比例",
            "label": "金额|比例"
        },
        "user_type": {
            "bsonType": "string",
            "description": "可领取用户，所有人或指定用户",
            "label": "指定范围"
        },
        "user_arr": {
            "bsonType": "array",
            "description": "指定哪些用户领取",
            "label": "选择用户",
            "foreignKey": "uni-id-users._id"
        },
        "order_amount": {
            "bsonType": "int",
            "description": "订单实付多少可用",
            "label": "实付金额"
        },
        "max_number": {
            "bsonType": "int",
            "description": "每位用户最多可领取多少张",
            "label": "每人可领"
        },
        "number": {
            "bsonType": "int",
            "description": "发行数量",
            "label": "发行数量"
        },
        "received_number": {
            "bsonType": "int",
            "description": "已领取数量",
            "permission": {
                "read": true,
                "write": true
            }
        },
        "start_time": {
            "bsonType": "timestamp",
            "description": "生效时间",
            "label": "生效时间"
        },
        "end_time": {
            "bsonType": "timestamp",
            "description": "过期时间",
            "label": "过期时间"
        },
        "allow_type": {
            "bsonType": "string",
            "description": "使用范围 指定商品|所有商品",
            "label": "使用范围",
            "trim": "both"
        },
        "goods_arr": {
            "bsonType": "array",
            "description": "指定商品组，关联商品表",
            "label": "选择商品",
            "foreignKey": "opendb-mall-goods._id"
        },
        "is_share": {
            "bsonType": "bool",
            "description": "是否共用其他优惠 是|否",
            "label": "共用优惠"
        },
        "state": {
            "bsonType": "string",
            "description": "状态 待发放、已发放、已过期",
            "label": "状态",
            "trim": "both"
        },
        "create_time": {
            "bsonType": "timestamp",
            "description": "创建时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}
