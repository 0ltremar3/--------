{
    "bsonType": "object",
    "required": [
        "goods_id",
        "user_id",
        "grade"
    ],
    "description": "商品评论",
    "permission": {
        "read": true,
        "create": "auth.uid != null",
        "update": false,
        "delete": false,
        "count": true
    },
    "properties": {
        "_id": {
            "description": "存储文档 ID（文章 ID），系统自动生成"
        },
        "goods_id": {
            "bsonType": "string",
            "description": "评论的商品id",
            "foreignKey": "opendb-mall-goods._id"
        },
        "goods_suk": {
            "bsonType": "array",
            "description": "商品规格"
        },
        "reply": {
            "bsonType": "string",
            "description": "商家回复"
        },
        "user_id": {
            "bsonType": "string",
            "description": "评论者的uid，参考 uni-id-users 表",
            "foreignKey": "uni-id-users._id",
            "forceDefaultValue": {
                "$env": "uid"
            }
        },
        "order_id": {
            "bsonType": "string",
            "description": "关联的订单号"
        },
        "grade": {
            "bsonType": "int",
            "description": "评价等级，1为一星"
        },
        "content": {
            "bsonType": "object",
            "description": "评论内容",
            "title": "评论内容",
            "items": {
                "text": {
                    "bsonType": "string",
                    "title": "文字内容",
                    "description": "文字内容"
                },
                "images": {
                    "bsonType": "array",
                    "arrayType": "file",
                    "maxLength": 6,
                    "fileMediaType": "image",
                    "description": "图片内容"
                }
            }
        },
        "create_date": {
            "bsonType": "timestamp",
            "description": "评论发表时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    },
    "version": "0.0.1"
}